{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && next dev",
    "dev:api": "npm run build:shared && npm run dev -w @college/api",
    "dev:all": "npm run build:shared && npm run dev & npm run dev:api",
    "build:shared": "npm run build -w @college/shared",
    "build": "npm run build:shared && next build",
    "build:api": "npm run build -w @college/api",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm run typecheck -w @college/api --if-present"
  },
  "dependencies": {
    "@college/shared": "*",
    "@college/supabase": "*",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "formik": "^2.4.6",
    "lucide-react": "^0.487.0",
    "next": "^14.2.26",
    "next-images": "^1.8.1",
    "react": "^18",
    "react-dom": "^18",
    "react-drag-drop-files": "^3.0.1",
    "react-hook-form": "^7.55.0",
    "sharp": "^0.34.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
